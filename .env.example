# Keys live in environment variables only: never in chat, memory or the repo.
# Each later build step adds the exact names it needs here, with empty values.
# Phase 0 step 2 (the risk engine) needs no keys.

# Phase 0 step 3: the desk's own Webull market-data connection (read only).
# From webull.com > Developer Tools > OpenAPI Management. Needs the OpenAPI
# market-data subscription (Advanced Quotes > OpenAPI Advanced Quotes).
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
# Only if the app was set up with 2FA on; leave empty otherwise.
WEBULL_ACCESS_TOKEN=
# Required: api.webull.com or api.sandbox.webull.com (Webull's test host). No default;
# an unset host is refused rather than sent to production (2026-10-02 audit).
# A paper-trading key works only on the test host (checked 29 Sep 2026).
WEBULL_HOST=

# Step 06: optional read-only corporate-action observation client.
# No real PriceBasis profile is enabled by configuring this key.
ALPHAVANTAGE_API_KEY=

# Step 06: optional reviewed action ledger + price-channel evidence (local paths).
# Both are required together. Leave empty until price-channel acceptance is done.
# No automatic refresh, source coverage, or volume profile is inferred.
DESK_ACTION_LEDGER=
DESK_ACTION_CHANNELS=

# G3: optional automatic Webull price/history source (local SQLite path).
# Leave unset until the read-only host check passes; see docs/VENDOR_BASIS.md.
# Does not attest action completeness or unknown volume definitions.
DESK_VENDOR_BASIS_DB=

# Step 09: optional reviewed normalized earnings/catalyst evidence JSON (local path).
# Raw calendars/income payloads do not qualify; see docs/EARNINGS_EVIDENCE.md.
DESK_EARNINGS_EVIDENCE=

# Step 09: SEC public data identifies the application/operator; this is NOT an API key.
# Use an application name and your real contact email. Never commit the filled value.
# The source-check CLI prompts privately when absent in an interactive terminal.
SEC_USER_AGENT=

# G3 follow-up: optional daily batch corporate-action observations, not orders.
# Requires DESK_VENDOR_BASIS_DB. Leave unset until provider acceptance;
# see docs/G3_FOLLOWUP.md. Prices and volume stay native Webull values.
MASSIVE_API_KEY=
DESK_AUTO_ACTION_DB=
# Explicit host-level inference, not a vendor guarantee or per-ticker review.
# Supported value: webull-native-no-split-window-v1. Default is unknown volume.
DESK_NATIVE_VOLUME_POLICY=

# G5a: optional read-only Alpaca market-data keys for historical SIP volume evidence
# (the probe, and the scanner when DESK_ALPACA_VOLUME_CACHE is set; no order use).
# Paper keys suffice for history; they do not establish real-time consolidated
# entitlement. See docs/ALPACA_VOLUME.md.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# G5a checkpoint 2: opt-in scanner volume source. Unset cache path = unchanged Webull
# volume path. Setting it verifies nothing by itself. Budget = Alpaca HTTP requests per
# scanner run (asset list plus bar pages), a positive integer.
DESK_ALPACA_VOLUME_CACHE=
DESK_ALPACA_VOLUME_BUDGET=

# G5a parent checkpoint 3, child Step 2: optional read-only tastytrade DXLink quotes.
# Personal OAuth refresh grant; client ID is deliberately not sent. Configuring these
# values does not activate a runner or prove live timing. See docs/TASTYTRADE_QUOTES.md.
TASTYTRADE_CLIENT_SECRET=
TASTYTRADE_REFRESH_TOKEN=
